# Public Vite env (prefix VITE_). No secrets here.
# Desktop apps load config from the Menzies config dir, not from .env in production.
# Never commit .env or private keys.

# Dev server port (must match Tauri devUrl). Default 2002.
VITE_DEV_PORT=2002

# Extension catalog (public, no secret):
#   https://menzies.mariesta.com/extensions/registry.json
# The publisher public key is pinned in src-tauri/extensions/publisher-key.json.
# The private key lives only on the landing-web release machine. See that repo's
# docs/extension-registry.md. Do not put it here.
# Developer overrides belong in extensions.json under the Menzies config dir
# (allowDowngrade, registryUrl). They are not shown in the app.
# registryUrl may be http://127.0.0.1:{port}/extensions/registry.json for a local test.
# Face recognition stays off until you install the signed package and enable it.
# Linux x86_64 package:
#   https://menzies.mariesta.com/extensions/packages/gallery-desktop-menzies/face-recognition/1.0.0/linux-x86_64.zip

# --- Tauri updater (GitHub Releases) ---
# This app uses its own signing keypair, separate from calculator-desktop-menzies.
# Pubkey is already set in src-tauri/tauri.conf.json → plugins.updater.pubkey
# Endpoint:
#   https://github.com/menzies-mariesta-com/gallery-desktop-menzies/releases/latest/download/latest.json
#
# Generate keys once (do not commit the private key; keep it outside the repo):
#   npm run tauri signer generate -- -w ~/.tauri/gallery-desktop-menzies.key -p "" --ci
#
# Build/signing only (set in CI or your shell; never commit):
# TAURI_SIGNING_PRIVATE_KEY=<path-or-contents-of-gallery-private-key>
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<optional-password>
